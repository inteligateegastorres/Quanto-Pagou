# Quanto Pagou — variáveis de ambiente
# Copie para .env e ajuste conforme necessário.

# Postgres (defaults batem com docker-compose.yml)
DATABASE_URL=postgresql://quantopagou:quantopagou_dev@localhost:5433/quantopagou

# Compras.gov.br
COMPRAS_API_BASE=https://dadosabertos.compras.gov.br

# Diretório local para snapshots brutos (mock de R2 enquanto não há bucket)
SNAPSHOTS_DIR=./snapshots

# Logs
LOG_LEVEL=INFO
