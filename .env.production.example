# Quanto Pagou — variaveis de PRODUCAO (Fase 0.5+)
# Copiar para painel de cada provedor (Vercel, Fly, GH Actions secrets).
# NAO COMMITAR valores reais.

# ----- Postgres (Supabase) -----
# Pegar em supabase.com/dashboard/project/_/settings/database (Connection pooler -> Transaction)
DATABASE_URL=postgresql://postgres:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ----- Compras.gov.br (worker FastAPI + GH Actions ingest) -----
COMPRAS_API_BASE=https://dadosabertos.compras.gov.br

# ----- Snapshots (Cloudflare R2) -----
# Worker roda local em /data/snapshots; sync para R2 via GH Actions.
SNAPSHOTS_DIR=/data/snapshots
R2_BUCKET=quantopagou-snapshots
R2_ENDPOINT=https://CONTA.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHAVE
R2_SECRET_ACCESS_KEY=SECRET

# ----- Frontend (Vercel) -----
QUANTOPAGOU_API_BASE=https://api.quantopagou.org
NEXT_PUBLIC_SITE_URL=https://quantopagou.org

# ----- Boletim (Fase 1, ainda nao ativado) -----
BUTTONDOWN_API_KEY=

# ----- Observabilidade -----
# Sentry — backend (api/main.py inicializa condicionalmente se DSN setado).
#   Instale antes: python -m uv add sentry-sdk
#   Pegue DSN em sentry.io > Projects > [projeto] > Settings > Client Keys.
SENTRY_DSN_API=
# Sample rate de tracing (default 0.05 = 5% das requisicoes).
SENTRY_TRACES_SAMPLE_RATE=0.05
# Sentry — frontend (Next.js; veja docs do @sentry/nextjs).
NEXT_PUBLIC_SENTRY_DSN=
PLAUSIBLE_DOMAIN=quantopagou.org

# ----- Logs -----
LOG_LEVEL=INFO
